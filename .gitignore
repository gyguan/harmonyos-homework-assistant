# DevEco Studio / IDE
.idea/
*.iml
local.properties

# HarmonyOS / Hvigor build output
.hvigor/
oh_modules/
**/oh_modules/
**/build/
**/.preview/

# Native (CMake) 中间产物
entry/.cxx/

# Agent 工作区本地记忆 / 会话数据，不入库
.workbuddy/

# Backend local secrets / overrides - never commit
backend/config/application-local.yml
backend/.e2e-session.json
backend/.env
backend/target/
backend/data/

# Signing material - never commit
signature/
*.p12
*.p7b
*.cer
*.pem
*.key
*.jks
*.keystore

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Logs
*.log
build_*log*.txt

# 客户端安装包本体不入库（构建产物，由 scripts/publish_hap_release.sh 上传到服务器）
releases/*.hap
releases/*.app

# Python validation cache
__pycache__/
*.pyc

# DevEco 生成的本机配置（只在本机有效，不入库）
.clangd
.clang-tidy
entry/oh-package-lock.json5
