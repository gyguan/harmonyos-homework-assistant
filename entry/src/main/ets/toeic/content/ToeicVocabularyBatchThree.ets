  static idsForDay(day:number):string[] {
    if (day<2 || day>13) return [];
    let start=Math.floor((day-2)*30/12);
    let end=Math.floor((day-1)*30/12);
    let ids:string[]=[];
    for (let i=start;i<end;i++) ids.push('V-'+String(151+i));
    return ids;
  }
