# Caddy 反向代理配置（生产环境 HTTPS）
#
# 用法：与 docker-compose.prod.yml 一起启动，Caddy 会自动向 Let's Encrypt 申请并续期证书。
# 站点地址由环境变量 SITE_ADDRESS 提供（默认域名见下），也可在 .env 里改成自己的域名。
#
# 换域名的前提：该域名的 A 记录已指向本服务器公网 IP，且服务器 80/443 端口已放行。

{$SITE_ADDRESS:192-144-143-141.sslip.io} {
	encode gzip

	# 访问日志（在容器内 /data/access.log，可选）
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}

	# 反向代理到后端容器（compose 内部网络，服务名 app）
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}

	# 上传的作业照片一般较大，放宽请求体限制（默认无限制；此处显式声明便于阅读）
	request_body {
		max_size 20MB
	}
}
