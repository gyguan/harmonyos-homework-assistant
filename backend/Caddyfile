# Caddy 反向代理配置（生产环境 HTTPS）
#
# 用法：与 docker-compose.prod.yml 一起启动，Caddy 会自动向 Let's Encrypt 申请并续期证书。
# 站点地址由环境变量 SITE_ADDRESS 提供（默认域名见下），也可在 .env 里改成自己的域名。
#
# 换域名的前提：该域名的 A 记录已指向本服务器公网 IP，且服务器 80/443 端口已放行。

{$SITE_ADDRESS:192-144-143-141.sslip.io} {
	encode gzip

	# 访问日志（在容器内 /data/access.log，可选）
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}

	# 反向代理到后端容器（compose 内部网络，服务名 app）
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}

	# 上传的作业照片一般较大，放宽请求体限制（默认无限制；此处显式声明便于阅读）
	request_body {
		max_size 20MB
	}
}

# ---------- 客户端安装包下载站（纯 HTTP）----------
# 为什么不用 HTTPS：本机在大陆节点、未备案域名，443 上 TLS 握手会被 SNI 级重置，
# 而 80 端口正常。故下载站固定走 http://<公网IP>/，供手机浏览器直接下载 .hap。
# 静态目录：/srv/releases（宿主机 ../releases，即 <部署根>/releases，见 docker-compose.prod.yml）
http://192.144.143.141 {
	encode gzip

	log {
		output file /data/download.log {
			roll_size 5mb
			roll_keep 3
		}
	}

	root * /srv/releases
	file_server

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
}
