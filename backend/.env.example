# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会进仓库）
#   cp .env.example .env   (Linux)
#   copy .env.example .env (Windows)

# ---------- 数据库（必填）----------
DB_USERNAME=homework
DB_PASSWORD=请改成强密码

# ---------- 初始家长账号（必填）----------
# 首次启动时自动创建；部署后请立即用 App 登录验证
BOOTSTRAP_ENABLED=true
BOOTSTRAP_LOGIN=parent
BOOTSTRAP_PASSWORD=请改成强密码

# ---------- 对外端口（可选）----------
# 服务器 8080 被占用时改这里，如 18080
# APP_PORT=8080

# ---------- HTTPS 域名（可选，用 Caddy 反向代理时需要）----------
# 不配则默认用免费域名 192-144-143-141.sslip.io（自动指向 192.144.143.141）
# 换成自己的域名时：先确保 A 记录已指向服务器 IP，且 80/443 已在云控制台放行
# SITE_ADDRESS=homework.example.com

# ---------- 登录会话有效期（可选，默认 168 小时 = 7 天）----------
# AUTH_TOKEN_TTL_HOURS=168

# ---------- AI 能力（可选，不配则 AI Tutor 降级）----------
# 通用字段：
#   AI_PROTOCOL     接口协议，responses（仅 OpenAI）或 chat-completions（国内厂商全部用这个）
#   AI_BASE_URL     服务地址，不要带 /chat/completions 这段路径
#   AI_CHAT_COMPLETIONS_PATH  路径，注意有些厂商把版本号放在 BASE_URL 里，路径要相应改短
#   AI_STRUCTURED_OUTPUT  是否用 json_schema 强约束；厂商不支持会返回 400，改 false 退回提示词 JSON
#
# 完整示例（OpenAI，需能访问境外网络）：
# AI_PROTOCOL=responses
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.openai.com
# AI_TUTOR_MODEL=gpt-5.6-luna
# AI_ORGANIZER_MODEL=gpt-5.6-luna
#
# 推荐：智谱 GLM-4.7-Flash（glm-4.7-flash 永久免费，200K 上下文）
# AI_PROTOCOL=chat-completions
# AI_API_KEY=你在 open.bigmodel.cn 生成的 Key
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_CHAT_COMPLETIONS_PATH=/chat/completions
# AI_TUTOR_MODEL=glm-4.7-flash
# AI_ORGANIZER_MODEL=glm-4.7-flash
#
# 备选（改 BASE_URL 与模型名即可，AI_PROTOCOL 都是 chat-completions）：
#   硅基流动    AI_BASE_URL=https://api.siliconflow.cn             路径留默认，模型如 Qwen/Qwen3-8B
#   阿里百炼    AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode  路径留默认，模型如 qwen-flash
#   火山方舟    AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3        路径 /chat/completions
#   腾讯混元    AI_BASE_URL=https://api.hunyuan.cloud.tencent.com  路径留默认，模型如 hunyuan-lite
#   百度千帆    AI_BASE_URL=https://qianfan.baidubce.com/v2                路径 /chat/completions，模型如 ernie-speed-128k
