{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaoban.local/schema/practice-preset-manifest.schema.json",
  "title": "Xiaoban Practice Preset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "generatedBy",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^G2/(CHINESE|MATH|ENGLISH)_(SYNC|EXTRA)\\.json$"
      },
      "maxItems": 6
    }
  }
}
