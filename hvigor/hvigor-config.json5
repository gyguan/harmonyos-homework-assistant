{
  "modelVersion": "5.0.0",
  "hvigorVersion": "6.26.4",
  "dependencies": {
    "@ohos/hvigor-ohos-plugin": "6.26.4"
  },
  "execution": {
    "analyze": "normal",
    "daemon": true,
    "incremental": false,
    "parallel": false,
    "typeCheck": true
  },
  "nodeOptions": {
    "maxOldSpaceSize": 12288,
    "exposeGC": true
  }
}
